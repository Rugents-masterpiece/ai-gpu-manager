[Unit]
Description=RTX3050 AI GPU manager production stack
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=rugent
Group=rugent
WorkingDirectory=/home/rugent/rtx3050-profile-prototype/production-candidate
EnvironmentFile=-/home/rugent/chatterbox-sk/config/tts-production.env
Environment=CUDA_VISIBLE_DEVICES=GPU-66081c19-9aca-8ca3-2cd6-20a4eea6c7d1
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=GPU_UUID=GPU-66081c19-9aca-8ca3-2cd6-20a4eea6c7d1
Environment=CHATTERBOX_PYTHON=/home/rugent/chatterbox-sk/.venv/bin/python
Environment=CHATTERBOX_APP=/home/rugent/chatterbox-sk/app
Environment=CHATTERBOX_PROJECT=/home/rugent/chatterbox-sk
Environment=TTS_IDLE_TIMEOUT_SECONDS=60
Environment=GPU_IDLE_TIMEOUT_SECONDS=300
Environment=RETRIEVAL_ACTIVATE_TIMEOUT_SECONDS=180
Environment=RETRIEVAL_DEACTIVATE_TIMEOUT_SECONDS=180
Environment=TTS_ACTIVATE_TIMEOUT_SECONDS=180
Environment=TTS_DEACTIVATE_TIMEOUT_SECONDS=180
Environment=STT_ACTIVATE_TIMEOUT_SECONDS=180
Environment=STT_RETIRE_TIMEOUT_SECONDS=180
ExecStart=/home/rugent/ai-stack/qwen-runtime/.venv/bin/python -m uvicorn manager_app:app --host 127.0.0.1 --port 18080
Restart=on-failure
RestartSec=10
SuccessExitStatus=SIGTERM
TimeoutStartSec=1800
TimeoutStopSec=240
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
